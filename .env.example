# --- Optional -----------------------------------------------------------
# Upstash Redis REST credentials. When BOTH are present, daily spread
# snapshots can be persisted (the history pipeline is otherwise skipped
# and sparklines stay simulated).
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# Slack or Discord incoming-webhook URL. When set, /api/arbitrage triggers
# /api/alerts and posts once per event per day when |spread| crosses 10pp.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
